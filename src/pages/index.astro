---
import Page from '../layouts/Page.astro';import Feature from '../components/Feature.astro';import GuideCard from '../components/GuideCard.astro';import Cover from '../components/Cover.astro';import Icon from '../components/Icon.astro';import AgencyIndex from '../components/AgencyIndex.astro';import Approach from '../components/Approach.astro';
import site from '../data/site.json';import {articles,href,withBase} from '../lib/content';
const posts=await articles();const featured=posts[0];
---
<Page>
<section class="hero" data-review-anchor="hero"><p class="eyebrow">The web design shortlist</p><h1>Good design.<br>Better <em>decisions.</em></h1><p class="intro">The web is full of possibilities. Find the agency that can turn yours into a website that works as beautifully as it looks.</p><div class="actions"><a class="button" href={withBase("/blog/")}>Explore the guides <Icon name="arrow-up-right"/></a><a class="text-link" href="#our-approach">Our approach</a></div></section>{featured&&<div class="digital-showcase" data-review-anchor="featured-guide"><Cover eager/><div class="digital-caption"><div><p class="eyebrow">The 2026 design guide</p><h2>{featured.data.title}</h2></div><a href={href(featured.data.slug)} aria-label="Read the featured web design guide"><Icon name="arrow-up-right"/></a></div></div>}<section class="section" data-review-anchor="agency-shortlist"><div class="index-head"><div><p class="eyebrow">Inside the guide</p><h2>Start your shortlist.</h2></div></div>{featured&&<AgencyIndex slug={featured.data.slug}/>}<p class="small" style="margin-top:20px">The first three agencies in the guide. Read the full comparison for rankings, qualifications, and methodology.</p></section><section class="section" data-review-anchor="guides"><Feature post={featured}/></section><Approach/></Page>
